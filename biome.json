{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "root": true,
  "extends": ["@starva/config/biome"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.expo",
      "!**/dist",
      "!**/build"
    ]
  }
}
