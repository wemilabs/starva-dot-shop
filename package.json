{
  "name": "starva-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "pnpm --filter @starva/web dev",
    "build": "pnpm --filter @starva/web build",
    "start": "pnpm --filter @starva/web start",
    "lint": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" lint",
    "typecheck": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" typecheck",
    "db:push": "node scripts/with-web-env.mjs drizzle-kit push"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@starva/config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3"
  }
}
